{
  "lock": false,
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": true
  },
  "tasks": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview"
  },
  "imports": {
    "@sveltejs/adapter-node": "npm:@sveltejs/adapter-node@^5.3.3",
    "@sveltejs/kit": "npm:@sveltejs/kit@^2.46.5",
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@^6.2.1",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.14",
    "svelte": "npm:svelte@^5.39.11",
    "tailwindcss": "npm:tailwindcss@^4.1.14",
    "vite": "npm:vite@^7.1.9"
  },
  "fmt": {
    "lineWidth": 160,
    "useTabs": false,
    "semiColons": true,
    "singleQuote": false,
    "indentWidth": 2
  },
  "unstable": [
    "sloppy-imports",
    "fmt-component"
  ]
}
