{
  "lock": false,
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview"
  },
  "imports": {
    "@sveltejs/adapter-node": "npm:@sveltejs/adapter-node@^5.3.3",
    "@sveltejs/kit": "npm:@sveltejs/kit@^2.43.2",
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@^6.2.0",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.13",
    "svelte": "npm:svelte@^5.39.5",
    "svelte-check": "npm:svelte-check@^4.3.2",
    "tailwindcss": "npm:tailwindcss@^4.1.13",
    "typescript": "npm:typescript@^5.9.2",
    "vite": "npm:vite@^7.1.7"
  },
  "fmt": {
    "lineWidth": 160,
    "useTabs": false,
    "semiColons": true,
    "singleQuote": false,
    "indentWidth": 2
  },
  "unstable": [
    "sloppy-imports",
    "fmt-component"
  ]
}
